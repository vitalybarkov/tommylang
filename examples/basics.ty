main (@c<@s> args) {
    // variables and types
    name = @s 'Tommy'
    version = @f32 1.0
    is_active = @bool true
    
    // condition and ternary
    status = is_active ? 'running' : 'stopped'
    
    // loop
    & i = @i32 0; i < 3; i++ {
        render('Version ' + version + ' is ' + status)
    }
    
    // null-conditional
    maybe_user = @User? null
    display_name = maybe_user?.name ?? 'Guest'
    
    render('Hello, ' + display_name)
}